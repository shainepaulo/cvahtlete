# ============================================================================
# ATHLETE CV — Variables d'environnement
# Copie ce fichier en .env.local et remplis les valeurs.
# .env.local n'est JAMAIS commité (déjà couvert par .gitignore).
# ============================================================================

# --- Supabase --------------------------------------------------------------
# supabase.com → ton projet → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique canonique du site (sert aux redirections d'authentification)
NEXT_PUBLIC_SITE_URL=https://cvathlete.com

# service_role : SERVEUR UNIQUEMENT. Ne jamais l'exposer au client / au repo.
# Utilisée par le script de seed du compte propriétaire et les webhooks.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Compte propriétaire (godpower) ----------------------------------------
# Semé une seule fois par le script de seed (lecture service_role).
# Choisis un mot de passe FORT. Toi seul le connais ; il ne transite nulle part.
# ⚠️ Jamais de vraie valeur ici : ce fichier est commité. Les vrais identifiants
# vont dans .env.local (ignoré par Git).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choisis-un-mot-de-passe-fort

# --- Stripe (paiements — PAIEMENT UNIQUE, jamais d'abonnement) ---------------
# dashboard.stripe.com → Developers → API keys / Webhooks
# Aucune donnée carte ne touche notre serveur : Stripe héberge le paiement.
# Webhook à créer : POST /api/stripe/webhook — événements :
#   checkout.session.completed, payment_intent.succeeded, payment_intent.canceled
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- E-mails transactionnels (Resend) ---------------------------------------
# resend.com → API Keys. EMAIL_FROM doit être un domaine vérifié chez Resend.
RESEND_API_KEY=re_...
EMAIL_FROM="ATHLETE CV <no-reply@cvathlete.com>"
# Destinataires internes des leads Sur-mesure (149 €+), séparés par des virgules.
LEAD_NOTIFY_EMAILS=shaine.paulo@gmail.com,toshirompika@gmail.com

# --- Vercel Cron (capture des essais Pro à J+3) ------------------------------
# Vercel le génère et l'envoie en Authorization: Bearer sur /api/cron/*.
CRON_SECRET=genere-une-longue-chaine-aleatoire
